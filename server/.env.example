# Copy this file to `.env` and fill in your own keys.
# Never commit the real `.env` file.

PORT=5000

# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# https://whoisjson.com
WHOIS_API_KEY=

# https://www.scrapingbee.com
SCRAPINGBEE_API_KEY=

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Rate limit for POST /api/analyze (per IP)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=20

# error | warn | info | debug  (debug logs every scanned URL)
LOG_LEVEL=info

# Score production: heuristic | ml | hybrid (default). Hybrid needs a trained
# model at data/model.json (included; retrain with `npm run train`).
SCORING_MODE=hybrid
ML_WEIGHT=0.5

# SQLite database file location. Defaults to server/data/guardian.db when unset.
# DATABASE_PATH=./data/guardian.db
